# ===========================================================
# Cabeceras HTTP — Cloudflare Pages
# Qué hace: evita que el navegador se quede con un CSS o un JS viejo
#           después de un cambio. Obligatorio en todo proyecto de JX.
# Ojo: aquí no se cachea el HTML porque la tasa se consulta en cada
#      visita; las imágenes sí se cachean fuerte porque no cambian.
# ===========================================================

/css/*
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

# Imágenes y favicons: cambian poquísimo, se cachean un año.
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Cabeceras de seguridad básicas para todo el sitio.
# - nosniff: impide que el navegador "adivine" el tipo de un archivo.
# - Referrer-Policy: al salir hacia doradoplaza.com solo se envía el
#   dominio, nunca la URL completa.
# - X-Frame-Options / frame-ancestors: nadie puede meter esta
#   herramienta dentro de un iframe suyo y hacerla pasar por propia.
# - HSTS: una vez visitada por HTTPS, el navegador nunca vuelve a
#   intentar HTTP. Se deja sin "preload" a propósito: eso se solicita
#   aparte y solo cuando el dominio definitivo esté decidido.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# El HTML no se cachea: la página debe consultar la tasa en cada visita
# y cualquier corrección de texto tiene que verse de inmediato.
/*.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/en/
  Cache-Control: no-cache
